__pycache__/
*.pyc
.mplconfig/
.vscode/
settings.json
*.npz
refractor_claude.md
refractor_codex.md
.gitignore
AGENT.md
# fit plots are regenerable output; the CSV/JSON they come from is tracked
src/calib_data/**/*.png
CLAUDE.md

# onn_module outputs: the MNIST download and the training runs are regenerable
# (model.pt aside, which is kept wherever you want it -- not tracked here)
data/

# a run's measured output is regenerable, but the notes and the report script
# that drive it are hand-written -- those are tracked
runs/*
!runs/*/
!runs/queue.ps1
runs/*/*
!runs/*/workflow.md
!runs/*/report.py
